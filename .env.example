# Beispiel für die Einstellungen von Daybreak. Diese Datei enthält niemals echte Geheimnisse.
# Kopiere sie nach ~/.config/daybreak.env oder setze DAYBREAK_ENV_FILE auf einen eigenen Ort.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Zufällig und geheim, zum Beispiel: openssl rand -hex 32
SESSION_SECRET=
# Hinter HTTPS empfohlen: sicheres Cookie, sobald die Verbindung als HTTPS erkannt wird.
SESSION_COOKIE_SECURE=auto
# Nur setzen, wenn ein vertrauenswürdiger Proxy davorsteht, zum Beispiel "loopback".
# Damit erkennt Daybreak HTTPS und die echte Absenderadresse.
# DAYBREAK_TRUST_PROXY=loopback

# Geschützte Systemadministration (root@root.de). Den Wert nur über
# `npm run superadmin:password -- <Pfad zu dieser Datei>` erzeugen lassen.
DAYBREAK_SUPERADMIN_PASSWORD_HASH=

# Daten. Standard: loop.db im Projektordner, weitere Organisationen im Ordner "data" daneben.
# DAYBREAK_DB_PATH=/var/lib/daybreak/loop.db
# DAYBREAK_DATA_DIR=/var/lib/daybreak/data
# DAYBREAK_BACKUP_ROOT=/var/backups/daybreak

# PostgreSQL statt SQLite (optional). Ohne diesen Eintrag bleibt es bei SQLite.
# Vorhandene Daten zieht `npm run migrate:postgres` um. Mehr dazu in docs/POSTGRESQL.md.
# DAYBREAK_DATABASE_URL=postgres://benutzer:passwort@localhost:5432/daybreak

# Name der ersten Organisation in der Oberfläche.
# DAYBREAK_PRIMARY_TENANT_NAME=Daybreak
# Erfundene Beispieldaten und Demo-Zugänge mit bekanntem Passwort. Nie mit echten Personaldaten!
# DAYBREAK_PRIMARY_DEMO=true
# Beispieldaten auch dann anlegen, wenn es Konten außerhalb von @loop.local gibt. Nur, wenn alle erfunden sind.
# DAYBREAK_DEMO_DATA_FOR_ALL_ACCOUNTS=true
# Öffentliche Demo: Einmal am Tag zu dieser Stunde (0 bis 23, Serverzeit) alle Beispieldaten neu anlegen.
# Das löscht die Daten der ersten Organisation. Wirkt nur im Demo-Modus.
# DAYBREAK_DEMO_RESET_HOUR=4
# Adresse, unter der Organisationen eine eigene Unteradresse bekommen, zum Beispiel firma.example.org.
# DAYBREAK_BASE_DOMAIN=example.org

# Daybreak steht unter der AGPL-3.0. Wer eine veränderte Fassung über das Netz anbietet,
# muss deren Quellcode zugänglich machen. Trage hier die Adresse deines Codes ein.
# DAYBREAK_SOURCE_URL=https://example.org/mein-daybreak

# Dayo kann eine lokale KI über Ollama nutzen (optional). Ohne sie antwortet Dayo aus der eingebauten Hilfe.
# DAYBREAK_ASSISTANT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# Automatische Programmierung (optional, nur mit SQLite). Ohne diese Einträge bleibt sie aus.
# Mehr dazu in docs/BETRIEB.md.
# DAYBREAK_GIT_REPOSITORY=/pfad/zu/daybreak.git
# DAYBREAK_AUTOMATION_JOBS_ROOT=/pfad/zu/daybreak_jobs
# DAYBREAK_CODEX_CLI=/pfad/zu/codex
# DAYBREAK_CODEX_MODEL=
